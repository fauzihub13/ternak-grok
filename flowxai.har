pubDate>Thu, 22 May 2025 23:03:00 GMT</pubDate>\n      <category>available</category>\n      <category>resolved</category>\n    </item>\n\n    <item>\n      <title>[API (us-east-1.api.x.ai)] Grok-3 Temporarily Unavailable</title>\n      <link>https://status.x.ai/api-us-east-1/INC2377cdea</link>\n      <guid isPermaLink=\"false\">INC2377cdea</guid>\n      <description><![CDATA[\n           <h3>Status: RESOLVED</h3>\n           <p>Severity: available</p>\n           <p>Resolved: Wed, 21 May 2025 10:20:00 GMT</p>\n           <hr />\n           <h4>Updates:</h4>\n           \n             <div>\n               <p><strong>Wed, 21 May 2025 10:20:00 GMT</strong></p>\n               <h3>Outage is Fixed</h3>\n               <p>We have restored the operation of Grok-3 models</p>\n             </div>\n           \n             <div>\n               <p><strong>Wed, 21 May 2025 10:02:00 GMT</strong></p>\n               <h3>Grok-3 Temporarily Unavailable</h3>\n               <p>Grok-3 is temporarily available. We have identified the issue and is restoring the service.</p>\n             </div>\n           \n      ]]></description>\n      <pubDate>Wed, 21 May 2025 10:02:00 GMT</pubDate>\n      <category>available</category>\n      <category>resolved</category>\n    </item>\n\n    <item>\n      <title>[API (us-east-1.api.x.ai)] Increased Latency for Chat Completions</title>\n      <link>https://status.x.ai/api-us-east-1/INC6cdd1aed</link>\n      <guid isPermaLink=\"false\">INC6cdd1aed</guid>\n      <description><![CDATA[\n           <h3>Status: RESOLVED</h3>\n           <p>Severity: available</p>\n           <p>Resolved: Tue, 20 May 2025 05:00:00 GMT</p>\n           <hr />\n           <h4>Updates:</h4>\n           \n             <div>\n               <p><strong>Tue, 20 May 2025 05:00:00 GMT</strong></p>\n               <h3>Issue Resolved</h3>\n               <p>The issue has been resolved. The latency is returning to normal.</p>\n             </div>\n           \n             <div>\